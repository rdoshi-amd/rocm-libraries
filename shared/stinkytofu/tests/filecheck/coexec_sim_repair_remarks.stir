# RUN: %stinkytofu-opt --arch gfx1250 %s --CoexecSimRepairPass=noWaitAlu --remarks --print-output 2>&1
#
# One remark per move, with the pattern, the windows and the predicted gain. The block is
# the one of coexec_sim_repair_scalar_shadow.stir, with every pattern enabled.

# CHECK: remark: CoexecSimRepairPass: entry: P1 scalar shadow: moved s_cmp_le_i32 + s_cmov_b32 + s_cmov_b32 from window 6 to window 3, predicted gain 3 cycles
# CHECK-NEXT: remark: CoexecSimRepairPass: entry: P1 scalar shadow: moved s_cmp_le_u32 + s_cmov_b32 from window 6 to window 3, predicted gain 10 cycles
# CHECK-NOT: CoexecSimRepairPass
# CHECK-LABEL: @coexec_sim_repair_remarks
st.func @coexec_sim_repair_remarks() {
^entry:
  v[0:7] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[116:131], v[0:7]) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
