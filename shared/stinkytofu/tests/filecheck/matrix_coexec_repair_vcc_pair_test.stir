# RUN: %stinkytofu-opt --arch gfx1250 %s --MatrixCoexecRepairPass --print-output
#
# The VCC carry pair v_add_co_u32 -> v_add_co_ci_u32 stays in order with nothing between
# it, and both stay ahead of the next VCC writer (v_cmp_gt_u32). The independent v_add
# fillers still sink past the v_cmp to a later WMMA.

# CHECK-LABEL: @vcc_pair
# CHECK: v50, vcc_lo0 = "st.v_add_co_u32"
# CHECK-NEXT: v52, vcc_lo0 = "st.v_add_co_ci_u32"
# CHECK: v[8:15] = "st.v_wmma_f32_16x16x32_bf16"
# CHECK-NEXT: vcc_lo0 = "st.v_cmp_gt_u32"
# CHECK-NEXT: v[16:23] = "st.v_wmma_f32_16x16x32_bf16"
# CHECK-NEXT: v54 = "st.v_add_f32"
# CHECK-NEXT: v56 = "st.v_add_f32"
# CHECK-NEXT: v[24:31] = "st.v_wmma_f32_16x16x32_bf16"

st.func @vcc_pair() {
^entry:
  s7 = "st.s_mov_b32"(0) { issueCycles = 1, latencyCycles = 1 }
  Successors: ^loop
^loop:
  label_loop:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], v[0:7]) { issueCycles = 1, latencyCycles = 8 }
  s5 = "st.s_mov_b32"(1) { issueCycles = 1, latencyCycles = 1 }
  v50, vcc_lo0 = "st.v_add_co_u32"(s5, v51) { issueCycles = 1, latencyCycles = 5 }
  v52, vcc_lo0 = "st.v_add_co_ci_u32"(v53, 0, vcc_lo0) { issueCycles = 1, latencyCycles = 5 }
  s6 = "st.s_mov_b32"(2) { issueCycles = 1, latencyCycles = 1 }
  v54 = "st.v_add_f32"(s6, v55) { issueCycles = 1, latencyCycles = 5 }
  s8 = "st.s_mov_b32"(3) { issueCycles = 1, latencyCycles = 1 }
  v56 = "st.v_add_f32"(s8, v57) { issueCycles = 1, latencyCycles = 5 }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[116:123], v[124:131], v[8:15]) { issueCycles = 1, latencyCycles = 8 }
  vcc_lo0 = "st.v_cmp_gt_u32"(v60, v61) { issueCycles = 1, latencyCycles = 5 }
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[132:139], v[140:147], v[16:23]) { issueCycles = 1, latencyCycles = 8 }
  v[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[148:155], v[156:163], v[24:31]) { issueCycles = 1, latencyCycles = 8 }
  v[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[164:171], v[172:179], v[32:39]) { issueCycles = 1, latencyCycles = 8 }
  s7, SCC0 = "st.s_add_u32"(s7, 1) { issueCycles = 1, latencyCycles = 1 }
  SCC0 = "st.s_cmp_lt_u32"(s7, 16) { issueCycles = 1, latencyCycles = 2 }
  "st.s_cbranch_scc1"(label_loop, SCC0) { issueCycles = 1, latencyCycles = 1, mod.label = { label = "label_loop", alignment = 1 } }
  Successors: ^loop, ^exit
^exit:
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}
